{
  "name": "sketch-to-code",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev -w examples/demo-app",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
