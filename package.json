{
  "name": "sketch-to-code",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev -w examples/demo-app",
    "typecheck": "tsc -b --noEmit",
    "e2e": "node tests/e2e/live-run.mjs && node tests/e2e/live-modify.mjs && node tests/e2e/live-add.mjs",
    "e2e:cli": "node packages/cli/tests/e2e/init-real-project.mjs",
    "e2e:onboard": "node packages/cli/tests/e2e/onboard-real-projects.mjs",
    "demo": "node tests/demo/record-60s.mjs --out demo",
    "e2e:published": "node packages/cli/tests/e2e/published-install.mjs",
    "e2e:ring-tw": "node tests/e2e/ring-tailwind.mjs",
    "e2e:caret": "node tests/e2e/caret-insert.mjs",
    "e2e:optimistic": "node tests/e2e/optimistic-scribble.mjs",
    "e2e:optimistic-ring": "node tests/e2e/optimistic-ring.mjs",
    "e2e:optimistic-preview": "node tests/e2e/optimistic-preview.mjs",
    "e2e:optimistic-reconcile": "node tests/e2e/optimistic-preview-reconcile.mjs",
    "e2e:optimistic-preview-live": "node tests/e2e/optimistic-preview-live.mjs",
    "e2e:optimistic-queue": "node tests/e2e/optimistic-queue.mjs",
    "e2e:verify-preview": "node tests/e2e/verify-preview-scripted.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
