{
  "name": "sketch-to-code",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev -w examples/demo-app",
    "typecheck": "tsc -b --noEmit",
    "e2e": "node tests/e2e/live-run.mjs && node tests/e2e/live-modify.mjs && node tests/e2e/live-add.mjs",
    "e2e:cli": "node packages/cli/tests/e2e/init-real-project.mjs",
    "e2e:onboard": "node packages/cli/tests/e2e/onboard-real-projects.mjs",
    "demo": "node tests/demo/record-60s.mjs --out demo"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}