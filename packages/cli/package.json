{
  "name": "sketch-to-code",
  "version": "0.1.0",
  "description": "Draw on your running app and it edits your source. `sketch` for a one-off with no install; `init` to keep it.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sketch-to-code": "./dist/bin.js",
    "s2c": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@s2c/vite-plugin": "*"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": false
    }
  }
}
